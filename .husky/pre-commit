# Stash unstaged changes to isolate staged ones in the working tree
git stash push --keep-index --include-untracked --quiet --message "pre-commit stash"
STASH_EXIT_CODE=$?

# Set up trap to pop stash on exit (success or failure)
trap 'if [ $STASH_EXIT_CODE -eq 0 ]; then git stash pop --quiet; fi' EXIT

# Run lint-staged for ESLint (file-based, on staged files)
pnpm lint-staged

# Run type checking via Turbo, filtered to packages affected by staged changes
pnpm turbo run check-types --filter=[HEAD] --ui=stream
pnpm -filter=@guess-logo/api test:unit
pnpm -filter=@guess-logo/game-core test
pnpm -filter=@guess-logo/games test