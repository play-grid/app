{
  "name": "guess-logo",
  "private": true,
  "scripts": {
    "dev":"pnpm run -r --parallel --aggregate-output dev",
    "lint":"pnpm run -r --parallel --aggregate-output lint",
    "build":"pnpm run -r build",
    "test:e2e": "pnpm --filter @guess-logo/frontend test:e2e",
    "deploy": "pnpm deploy:frontend && pnpm deploy:api",
    "deploy:frontend": "pnpm --filter frontend build && cd apps/frontend && pnpm wrangler pages deploy",
    "deploy:api": "pnpm --filter api deploy"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "lint-staged": "^16.1.5",
    "simple-git-hooks": "^2.13.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.9"
    }
  },
  "lint-staged": { "apps/frontend/**/*.{js,ts,tsx}": "eslint --fix --config apps/frontend/eslint.config.js" },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "post-checkout": "sh scripts/post-checkout.sh"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
