{
  "name": "guess-logo",
  "private": true,
  "scripts": {
    "dev": "pnpm run -r --parallel --aggregate-output dev",
    "lint": "pnpm run -r --parallel --aggregate-output lint",
    "build": "pnpm run -r build",
    "test:e2e": "pnpm --filter @guess-logo/frontend test:e2e",
    "deploy": "pnpm deploy:frontend && pnpm deploy:api",
    "deploy:frontend": "pnpm --filter frontend build && cd apps/frontend && pnpm wrangler pages deploy",
    "deploy:api": "pnpm --filter api deploy"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "lint-staged": "^16.1.5",
    "simple-git-hooks": "^2.13.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.9"
    }
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,ts,tsx}": "eslint --fix --config apps/frontend/eslint.config.js"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "post-checkout": "sh scripts/post-checkout.sh"
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
