{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": "./",
    "paths": {
      "@/api/*": ["./src/*"],
      "@/env": ["./src/env"]
    },
    "typeRoots": ["./node_modules/@types", "./node_modules/@cloudflare"],
    "noEmit": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  }
}