{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@/env": ["./src/env"]
    },
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "noEmit": false,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "./worker-configuration.d.ts",
    "./vitest.config.ts"
, "../../packages/shared/data/sport/load-region.ts"  ]
}