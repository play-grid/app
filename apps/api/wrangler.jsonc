{
	"name": "playgrid-api",
	"main": "src/app.ts",
	"compatibility_date": "2025-09-01",
 	"compatibility_flags": [
  		"nodejs_compat"
  	],
 	"workers_dev": true,
	"vars": {
		"BETTER_AUTH_URL":"http://localhost:5173",
 		"ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://guess-logo.pages.dev,https://games.mohadalaa.com,https://playgrid.mohadalaa.com,https://staging.playgrid.mohdalaa.com",
		"API_URL": "http://localhost:8787",
		"LOG_LEVEL": "debug",
		"R2_PUBLIC_URL": "https://r2.playgrid.mohdalaa.com"
	},
	// FRONTEND
 	 "assets": {
    		"directory": "../frontend/dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
  	},
	"ai": {
		"binding": "AI"
	},
 	"env": {
 		"staging": {
 			"name": "playgrid-api-staging",
 			"routes": [
				{
				"pattern":"staging.playgrid.mohdalaa.com",
      			"custom_domain": true
				}
			 ],
			"durable_objects": {
				"bindings": [
					{
						"name": "GAME_SESSION",
						"class_name": "GameSessionObject"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "LOGO_CACHE",
					"id": "eb1698afccf64de8993284056aaa5598",
					"preview_id": "beac11884fff4280a9ecad02adf2961c"
				},
				{
					"binding": "QUESTIONS",
					"id": "07bd0d479a8444139fc0b3584f9c28ae",
					"preview_id": "07bd0d479a8444139fc0b3584f9c28ae"
				}
			],
			"d1_databases": [
				{
					"binding": "GAME_HUB_DB",
					"database_name": "game-hub-db-staging",
					"database_id": "5cb8afa5-c590-4dd6-b994-abd84979e8b4",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "PLAY_GRID_BUCKET",
					"bucket_name": "guess-logo"
				}
			],
			"ratelimits": [
				{
					"name": "RATE_LIMITER",
					"namespace_id": "1001",
					"simple": {
						"limit": 25,
						"period": 10
					}
				}
			],
			"vars": {
				"BETTER_AUTH_URL":"https://staging.playgrid.mohadalaa.com",
				"ALLOWED_ORIGINS": "https://staging.guess-logo.pages.dev,https://games.mohadalaa.com",
				"LOG_LEVEL": "info",
				"NODE_ENV": "staging",
				"R2_PUBLIC_URL": "https://r2.playgrid.mohdalaa.com",
				"API_URL": "https://staging.playgrid.mohadalaa.com"
			},
			"ai": {
				"binding": "AI"
			}
		},
 	"production": {
 			"name": "playgrid-api-production",
 			"routes": [
				{
				"pattern": "playgrid.mohdalaa.com",
      			"custom_domain": true
				}
			 ],
			"durable_objects": {
				"bindings": [
					{
						"name": "GAME_SESSION",
						"class_name": "GameSessionObject"
					}
				]
			},
			"kv_namespaces": [
				{
					"binding": "LOGO_CACHE",
					"id": "eb1698afccf64de8993284056aaa5598",
					"preview_id": "beac11884fff4280a9ecad02adf2961c"
				},
				{
					"binding": "QUESTIONS",
					"id": "07bd0d479a8444139fc0b3584f9c28ae",
					"preview_id": "07bd0d479a8444139fc0b3584f9c28ae"
				}
			],
			"d1_databases": [
				{
					"binding": "GAME_HUB_DB",
					"database_name": "GAME_HUB_DB",
					"database_id": "985b789d-4062-4f3f-9abb-0b9553650548",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "PLAY_GRID_BUCKET",
					"bucket_name": "guess-logo"
				}
			],
			"ratelimits": [
				{
					"name": "RATE_LIMITER",
					"namespace_id": "1001",
					"simple": {
						"limit": 25,
						"period": 10
					}
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vars": {
				"BETTER_AUTH_URL": "https://playgrid.mohdalaa.com",
				"ALLOWED_ORIGINS": "https://playgrid.mohdalaa.com",
				"VITE_PUBLIC_POSTHOG_HOST":"https://us.i.posthog.com",
				"LOG_LEVEL": "warn",
				"NODE_ENV": "production",
				"R2_PUBLIC_URL": "https://r2.playgrid.mohdalaa.com",
				"API_URL": "https://playgrid.mohdalaa.com"
			}
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_SESSION",
				"class_name": "GameSessionObject"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "LOGO_CACHE",
			"id": "eb1698afccf64de8993284056aaa5598",
			"preview_id": "beac11884fff4280a9ecad02adf2961c"
		},
		{
			"binding": "QUESTIONS",
			"id": "07bd0d479a8444139fc0b3584f9c28ae",
			"preview_id": "07bd0d479a8444139fc0b3584f9c28ae"
		}
	],
	"d1_databases": [
		{
			"binding": "GAME_HUB_DB",
			"database_name": "GAME_HUB_DB",
			"database_id": "985b789d-4062-4f3f-9abb-0b9553650548",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "PLAY_GRID_BUCKET",
			"bucket_name": "guess-logo"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 25,
				"period": 10
			}
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GameSessionObject"
			]
		}
	],
	"observability": {
		"enabled": true
	}
}