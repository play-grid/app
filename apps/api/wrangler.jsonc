{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
    "migrations": [
    {
      "new_sqlite_classes": ["GameRoom"],
      "tag": "v1",
    },
  ],
  "durable_objects": {
    "bindings": [      
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },"observability": {
    "enabled": true,
  }
}