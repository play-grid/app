{
  "name": "@guess-logo/api",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "tsc --project tsconfig.build.json",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply GAME_HUB_DB --local",
    "db:migrate": "tsx src/scripts/migrate-and-seed.prod.ts",
    "db:migrate-and-seed": "pnpm db:migrate && pnpm seed:prod",
    "seed": "tsx seeds/seed-local.ts",
    "seed:local": "tsx seeds/seed-local.ts",
    "seed:prod": "tsx src/scripts/generate-seed-sql.ts && wrangler d1 execute GAME_HUB_DB --file seeds/seed-prod.sql --remote",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/auth/index.ts --output src/db/auth.schema.ts -y",
    "generate": "plop",
    "generate:crud": "plop crud",
    "generate:route": "plop route"
  },
  "exports": {
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "default": "./dist/routes/index.js"
    },
    "./schemas": "./src/schemas.ts"
  },
  "dependencies": {
    "@guess-logo/shared": "workspace:*",
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@hono/zod-openapi": "^1.1.0",
    "@scalar/hono-api-reference": "^0.9.16",
    "better-auth": "^1.3.34",
    "better-auth-cloudflare": "^0.2.8",
    "dotenv": "^17.2.2",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.5",
    "hono-rate-limiter": "^0.4.2",
    "stoker": "^2.0.1",
    "tmdb-ts": "^2.0.2",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.2",
    "@cloudflare/workers-types": "^4.20250831.0",
    "@guess-logo/eslint-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "better-sqlite3": "^12.4.1",
    "cloudflare": "^5.2.0",
    "drizzle-kit": "^0.31.6",
    "plop": "^4.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vitest": "~3.2.4",
    "wrangler": "^4.33.2"
  }
}
