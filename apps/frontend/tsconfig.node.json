{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@api/*": [
        "../../apps/api/src/*"
      ]
    }
  },
  "include": [
  "vite.config.ts",
  "**/*.ts",
  "cypress/**/*.ts"
 ]
}
