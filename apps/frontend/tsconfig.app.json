{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "node"],
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@api/*": [
        "../../apps/api/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}