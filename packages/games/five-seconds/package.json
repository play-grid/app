{
  "name": "@guess-logo/five-seconds",
  "version": "0.0.1",
  "private": true,
  "type": "module",
    "exports": {
    "./definition": "./src/definition.ts",
    "./schema":"./src/schema.ts",
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    ".": {
      "types": "./src/logic/index.ts",
      "default": "./src/logic/index.ts"
    },
    "./logic": {
      "types": "./src/logic/index.ts",
      "default": "./src/logic/index.ts"
    },
    "./logic/*": {
      "types": "./src/logic/*.ts",
      "default": "./src/logic/*.ts"
    }
  },
  "dependencies": {
    "@guess-logo/game-core": "workspace:*",
    "@guess-logo/shared": "workspace:*",
    "react": "catalog:react19",
    "immer": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:react19",
    "typescript": "catalog:"
  }
}
