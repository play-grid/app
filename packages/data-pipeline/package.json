{
  "name": "@guess-logo/data-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./transformers": {
      "types": "./dist/transformers/index.d.ts",
      "import": "./dist/transformers/index.js",
      "default": "./dist/transformers/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "default": "./dist/sync/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js",
      "default": "./dist/sources/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@guess-logo/data-provider": "workspace:*",
    "@guess-logo/logger": "workspace:*",
    "zod": "catalog:",
    "drizzle-orm":"catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251107.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "vitest": "catalog:"
  }
}
