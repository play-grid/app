{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.js", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", "!apps/admin/**"]
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache":true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "test":{}
  }
}